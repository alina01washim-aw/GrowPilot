{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec \"node ./build.mjs && node --import dotenv/config --enable-source-maps ./dist/index.mjs\"",
    "build": "node ./build.mjs",
    "start": "node --import dotenv/config --enable-source-maps ./dist/index.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "mqtt": "^5.10.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
